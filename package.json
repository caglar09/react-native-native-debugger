{
  "name": "react-native-native-debugger",
  "version": "0.3.0",
  "description": "Dev-only native log and error bridge for React Native, with optional source-patch integrations that mirror upstream native logs and surface real caught failures.",
  "main": "index.js",
  "types": "index.d.ts",
  "react-native": "index.js",
  "license": "MIT",
  "keywords": [
    "react-native",
    "debug",
    "native",
    "logs",
    "errors",
    "logcat",
    "rnfs",
    "blob-util",
    "background-downloader"
  ],
  "files": [
    "index.js",
    "index.d.ts",
    "android/",
    "ios/",
    "cli/",
    "react-native-native-debugger.podspec",
    "react-native.config.js",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "AGENTS.md",
    "CLAUDE.md",
    "GEMINI.md"
  ],
  "bin": {
    "rn-native-debugger": "cli/index.js"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "doctor": "node cli/index.js doctor",
    "patch": "node cli/index.js patch",
    "unpatch": "node cli/index.js unpatch"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": ">=0.76.0",
    "react-native-fs": "*",
    "@dr.pogodin/react-native-fs": "*",
    "react-native-blob-util": "*",
    "@kesha-antonov/react-native-background-downloader": "*"
  },
  "peerDependenciesMeta": {
    "react-native-fs": {
      "optional": true
    },
    "@dr.pogodin/react-native-fs": {
      "optional": true
    },
    "react-native-blob-util": {
      "optional": true
    },
    "@kesha-antonov/react-native-background-downloader": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18"
  }
}
